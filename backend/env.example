# Server-side only. NEVER write these values into iOS source or GitHub.
OPENAI_API_KEY=replace-with-your-private-OpenAI-API-key
MYRADIO_ACCESS_TOKEN=replace-with-a-long-random-private-test-token
OPENAI_MODEL=gpt-6-luna
PORT=8080

# Natural AI voice provider: January 6, 2027 retirement of this Speech API model
# requires migration to the realtime/speech replacement before that date.
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# For long-term, premium, realistic Japanese speech (recommended, requires paid provider):
# VOICE_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=keep-this-in-Secret-Manager
# ELEVENLABS_MODEL=eleven_v4
# ELEVENLABS_VOICE_MAP={"cedar":"JAPANESE_VOICE_ID_1","onyx":"JAPANESE_VOICE_ID_2","marin":"JAPANESE_VOICE_ID_3","coral":"JAPANESE_VOICE_ID_4"}
# Voice IDs must come from your own licensed ElevenLabs voice library.
